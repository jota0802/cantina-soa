%% Entrega 1: os contratos existem, os serviços ainda são planejados (cinza e tracejados).
flowchart LR
  cliente(["Cliente<br/>curl · app · navegador"])

  subgraph CON["contratos/ · escritos antes do código"]
    direction TB
    c1@{ shape: doc, label: "cardapio.yaml<br/>OpenAPI · padrão da turma" }
    c2@{ shape: doc, label: "pedidos.yaml<br/>OpenAPI" }
    c3@{ shape: doc, label: "pedido-confirmado.json<br/>evento CloudEvents" }
  end

  pedidos["Pedidos · planejado<br/>Node.js · porta 8082"]
  car["Cardápio · planejado<br/>Python 3 · porta 8081"]
  av["Avisos · planejado<br/>Go · porta 8083"]

  cliente -->|"pedidos.yaml"| pedidos
  pedidos -->|"cardapio.yaml"| car
  pedidos -.->|"pedido-confirmado.json"| av
  CON ~~~ cliente

  subgraph LEG["Legenda"]
    direction LR
    la["quem chama"] -->|"chamada síncrona<br/>HTTP + JSON, espera a resposta"| lb["quem responde"]
    lc["quem publica"] -.->|"evento assíncrono<br/>não espera o consumidor"| ld["quem consome"]
    lp["cinza e tracejado:<br/>planejado, ainda não existe"]
  end

  classDef externo fill:#f2f2f2,stroke:#555,color:#222
  classDef contrato fill:#eef7ee,stroke:#2e7d32,color:#1b4d1e
  classDef planejado fill:#f7f7f7,stroke:#9e9e9e,stroke-dasharray:5 5,color:#757575
  classDef legenda fill:#ffffff,stroke:#999,color:#333

  class cliente externo
  class c1,c2,c3 contrato
  class pedidos,car,av,lp planejado
  class la,lb,lc,ld legenda

  %% 0 a 2 são planejadas; 3 só posiciona os contratos.
  linkStyle 0,1,2 stroke:#9e9e9e,color:#757575
  style CON fill:#fbfefb,stroke:#2e7d32
  style LEG fill:#fafafa,stroke:#bbb
